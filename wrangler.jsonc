{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "studios28",
    "compatibility_date": "2026-08-17",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "secrets": {
        "required": [
            "MONGODB_URI",
            "IMAGEKIT_PUBLIC_KEY",
            "IMAGEKIT_PRIVATE_KEY",
            "IMAGEKIT_URL_ENDPOINT"
        ]
    },
    "main": "@tanstack/react-start/server-entry"
}
